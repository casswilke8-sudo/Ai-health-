import { useState } from "react";

const DIETS = ["No restrictions","Vegetarian","Vegan","Gluten-free","Halal","Kosher","Keto","Paleo"];

const PLANS = {
  default: {
    meal: `7-DAY MEAL PLAN
(~1,400–1,600 calories/day for weight loss)

MONDAY
• Breakfast: 2 scrambled eggs + spinach + black coffee or herbal tea
• Lunch: Grilled chicken breast + quinoa + steamed zucchini
• Dinner: Baked salmon + roasted sweet potato + green beans
• Snack: Rice cakes + almond butter

TUESDAY
• Breakfast: Oatmeal + blueberries + cinnamon
• Lunch: Turkey lettuce wraps + sliced cucumber
• Dinner: Stir-fry chicken + bok choy + brown rice
• Snack: Hard boiled egg + baby carrots

WEDNESDAY
• Breakfast: Greek yogurt (plain) + strawberries
• Lunch: Tuna + olive oil + lemon on rice crackers
• Dinner: Ground turkey taco bowl — rice, salsa, avocado, romaine
• Snack: Handful of walnuts

THURSDAY
• Breakfast: Smoothie — spinach, banana, almond milk, protein powder
• Lunch: Lentil soup (low sodium)
• Dinner: Baked chicken thighs + roasted carrots + mashed cauliflower
• Snack: Apple slices + peanut butter

FRIDAY
• Breakfast: 2 eggs + sautéed kale + whole grain toast
• Lunch: Grilled shrimp salad — romaine, cucumber, olive oil dressing
• Dinner: Turkey meatballs + zucchini noodles + marinara
• Snack: Plain rice cakes

SATURDAY
• Breakfast: Veggie omelette (peppers, spinach, mushrooms)
• Lunch: Chicken and veggie soup
• Dinner: Baked cod + steamed broccoli + quinoa
• Snack: Celery + almond butter

SUNDAY
• Breakfast: Oatmeal + banana + chia seeds
• Lunch: Turkey and avocado wrap (corn tortilla)
• Dinner: Grilled salmon + asparagus + brown rice
• Snack: Hard boiled egg

BLOAT-BUSTING RULES:
✓ Avoid carbonated drinks, raw onions, and chewing gum
✓ Peppermint tea after meals helps digestion
✓ Eat slowly and chew thoroughly
✓ No honey — check labels on granola bars, teas, dressings`,

    workout: `WEEKLY WORKOUT ROUTINE
(3–5 days/week, no gym required)

MONDAY — Full Body Strength (40 min)
• Squats — 3 sets × 12 reps
• Lunges — 3 sets × 10 each leg
• Push-ups — 3 sets × 10
• Dumbbell rows — 3 sets × 12
• Plank — 3 × 30 seconds

TUESDAY — Cardio (30 min)
• Brisk walk, jog, or cycling
• Keep heart rate at 60–70% of max
• Finish with 5 min cool-down stretch

WEDNESDAY — Rest or light yoga/stretching

THURSDAY — Lower Body (40 min)
• Sumo squats — 3 × 15
• Glute bridges — 3 × 15
• Step-ups — 3 × 10 each leg
• Calf raises — 3 × 20
• Side-lying leg raises — 3 × 15

FRIDAY — Cardio + Core (35 min)
• 20 min brisk walk or jog
• Crunches — 3 × 15
• Bicycle crunches — 3 × 15
• Leg raises — 3 × 12
• Dead bug — 3 × 10

SATURDAY — Upper Body (35 min)
• Dumbbell shoulder press — 3 × 12
• Bicep curls — 3 × 12
• Tricep dips — 3 × 12
• Chest press — 3 × 12
• Bent-over rows — 3 × 12

SUNDAY — Rest or 20 min walk

At this pace, expect to lose 1–1.5 lbs/week.
Goal of 20 lbs reached in roughly 14–20 weeks.`,

    tips: `TIPS & HABITS FOR SUCCESS

NUTRITION
• Drink 16 oz of water before every meal — reduces overeating
• Never skip breakfast — it stabilizes blood sugar and reduces cravings
• Prep proteins and grains on Sunday to stay on track all week
• Always read labels — honey hides in granola bars, dressings, teas, and sauces

DIGESTION
• Eat slowly and chew each bite thoroughly
• Peppermint or ginger tea after meals soothes bloating
• Avoid raw onions, broccoli in large amounts, carbonated drinks, and gum
• Try a food journal for 2 weeks to identify your personal bloat triggers

FITNESS
• Start with 3 workout days/week and build up — consistency beats intensity
• Walk after dinner — even 10 min improves digestion and burns extra calories
• Stretch for 5 min before bed to reduce soreness

MINDSET
• Weigh yourself once a week, same time, same day — not daily
• Track meals in MyFitnessPal (free) for the first month
• Sleep 7–8 hours — poor sleep raises hunger hormones by up to 30%
• Progress photos every 2 weeks — the scale doesn't show muscle gain`
  }
};

export default function App() {
  const [step, setStep] = useState("form");
  const [diet, setDiet] = useState([]);
  const [tab, setTab] = useState("meal");
  const [error, setError] = useState("");
  const [plan, setPlan] = useState(null);
  const [form, setForm] = useState({
    goalWeight:"", healthGoals:"", medicalHistory:"",
    digestiveIssues:"", dailySchedule:"", mealPrep:"", groceryBudget:""
  });

  function set(k){ return e => setForm(p=>({...p,[k]:e.target.value})); }

  function toggleDiet(d){
    if(d==="No restrictions"){ setDiet(["No restrictions"]); return; }
    setDiet(prev=>{
      const next=prev.filter(x=>x!=="No restrictions");
      return next.includes(d)?next.filter(x=>x!==d):[...next,d];
    });
  }

  function customize(base) {
    let meal = base.meal;
    let workout = base.workout;
    let tips = base.tips;

    // Calorie adjustment based on goal
    const goalLbs = parseInt(form.goalWeight);
    const currentNote = form.healthGoals.toLowerCase().includes("muscle") 
      ? "(~1,600–1,800 calories/day to build muscle)" 
      : "(~1,400–1,600 calories/day for weight loss)";
    meal = meal.replace("(~1,400–1,600 calories/day for weight loss)", currentNote);

    // Add allergy warnings
    const allergies = form.medicalHistory.toLowerCase();
    if (allergies.includes("honey")) {
      tips = tips.replace("honey hides in granola bars, dressings, teas, and sauces",
        "⚠️ HONEY ALLERGY: Strictly avoid honey — it hides in granola bars, energy bars, teas, dressings, marinades, and sauces. Always read every label.");
    }
    if (allergies.includes("nut") || allergies.includes("almond") || allergies.includes("peanut")) {
      meal = meal.replace(/almond butter/g, "sunflower seed butter").replace(/walnuts/g, "pumpkin seeds").replace(/peanut butter/g, "sunflower seed butter");
    }

    // Add bloat notes
    const bloat = form.digestiveIssues.toLowerCase();
    if (bloat.includes("bloat")) {
      tips = "⚠️ BLOATING FOCUS: Your plan prioritizes low-bloat foods throughout.\n\n" + tips;
    }

    // Add vegan/vegetarian swaps
    const dietStr = diet.join(", ").toLowerCase();
    if (dietStr.includes("vegan")) {
      meal = meal.replace(/chicken breast/g, "tofu").replace(/salmon/g, "tempeh").replace(/turkey/g, "lentils").replace(/tuna/g, "chickpeas").replace(/eggs/g, "tofu scramble").replace(/Greek yogurt \(plain\)/g, "coconut yogurt").replace(/Hard boiled egg/g, "edamame");
    } else if (dietStr.includes("vegetarian")) {
      meal = meal.replace(/Grilled chicken breast/g, "Grilled tofu").replace(/turkey/g, "lentil").replace(/salmon/g, "tempeh").replace(/Tuna/g, "Chickpea salad").replace(/shrimp/g, "halloumi").replace(/cod/g, "tempeh");
    }

    return { meal, workout, tips };
  }

  function generate() {
    if (!form.goalWeight || !form.healthGoals) {
      setError("Please fill in your goal weight and health goals.");
      return;
    }
    setError("");
    setStep("loading");
    setTimeout(() => {
      const customized = customize(PLANS.default);
      setPlan(customized);
      setStep("results");
    }, 1800);
  }

  const inp = {
    width:"100%", padding:"10px 14px", border:"1.5px solid #ddd",
    borderRadius:8, fontFamily:"inherit", fontSize:"0.875rem",
    background:"#f8f7f4", boxSizing:"border-box", outline:"none"
  };
  const lbl = { display:"block", fontSize:"0.8rem", fontWeight:600, marginBottom:6 };
  const secLabel = { fontSize:"0.65rem", textTransform:"uppercase", letterSpacing:"0.12em", color:"#7a9e7e", fontWeight:600, marginBottom:16 };

  if (step === "loading") return (
    <div style={{display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",height:"100vh",background:"#faf7f2"}}>
      <div style={{width:44,height:44,border:"3px solid #c4d9c6",borderTopColor:"#7a9e7e",borderRadius:"50%",animation:"spin 0.8s linear infinite",marginBottom:20}}/>
      <style>{`@keyframes spin{to{transform:rotate(360deg)}}`}</style>
      <h3 style={{fontFamily:"Georgia,serif",fontWeight:400,marginBottom:8}}>Building your plan…</h3>
      <p style={{color:"#888",fontSize:"0.875rem"}}>Just a moment</p>
    </div>
  );

  if (step === "results") return (
    <div style={{fontFamily:"system-ui,sans-serif",background:"#faf7f2",minHeight:"100vh"}}>
      <div style={{background:"#2a2a2a",color:"white",padding:"18px 24px"}}>
        <h2 style={{fontFamily:"Georgia,serif",fontWeight:400,fontSize:"1.3rem",margin:0}}>Your Wellness Plan ✨</h2>
        <p style={{color:"#c4d9c6",fontSize:"0.75rem",margin:"4px 0 0"}}>Personalized for: {form.healthGoals.slice(0,50)}</p>
      </div>
      <div style={{maxWidth:680,margin:"0 auto",padding:"24px 16px 80px"}}>
        <div style={{background:"white",borderRadius:12,boxShadow:"0 2px 16px rgba(0,0,0,0.07)",overflow:"hidden"}}>
          <div style={{display:"flex",borderBottom:"1px solid #eee"}}>
            {[["meal","🥗 Meal Plan"],["workout","💪 Workout"],["tips","✨ Tips"]].map(([k,l])=>(
              <button key={k} onClick={()=>setTab(k)} style={{
                flex:1, padding:"13px 4px", border:"none",
                borderBottom: tab===k ? "2px solid #7a9e7e" : "2px solid transparent",
                background:"none", fontFamily:"inherit", fontSize:"0.8rem",
                fontWeight:500, color: tab===k ? "#2a2a2a" : "#888", cursor:"pointer"
              }}>{l}</button>
            ))}
          </div>
          <div style={{padding:"24px 28px", fontSize:"0.875rem", lineHeight:2, whiteSpace:"pre-wrap", color:"#2a2a2a"}}>
            {plan[tab]}
          </div>
        </div>
        <button onClick={()=>{setStep("form");setPlan(null);setTab("meal");}}
          style={{marginTop:20,padding:"10px 24px",border:"1.5px solid #2a2a2a",borderRadius:100,
          background:"none",fontFamily:"inherit",fontSize:"0.825rem",cursor:"pointer"}}>
          ← Start over
        </button>
      </div>
    </div>
  );

  return (
    <div style={{fontFamily:"system-ui,sans-serif",background:"#faf7f2",minHeight:"100vh"}}>
      <div style={{background:"#2a2a2a",padding:"16px 24px",display:"flex",alignItems:"center",gap:10}}>
        <div style={{width:22,height:22,background:"#7a9e7e",borderRadius:"50% 50% 50% 0",transform:"rotate(-45deg)"}}/>
        <span style={{color:"white",fontFamily:"Georgia,serif",fontSize:"1.1rem"}}>Nourish & Move</span>
      </div>
      <div style={{background:"linear-gradient(135deg,#2a2a2a,#3d3530)",color:"white",padding:"36px 24px",textAlign:"center"}}>
        <h1 style={{fontFamily:"Georgia,serif",fontSize:"1.9rem",fontWeight:400,marginBottom:10}}>
          Your body. <span style={{color:"#c4d9c6"}}>Your plan.</span>
        </h1>
        <p style={{color:"rgba(255,255,255,0.6)",fontSize:"0.875rem",maxWidth:380,margin:"0 auto"}}>
          Fill in your details and get a personalized meal plan and workout routine instantly.
        </p>
      </div>

      <div style={{maxWidth:640,margin:"0 auto",padding:"28px 16px 80px"}}>
        <div style={{background:"white",borderRadius:14,padding:"28px 24px",boxShadow:"0 2px 16px rgba(0,0,0,0.07)"}}>

          <p style={secLabel}>Your Goals</p>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Goal weight and body type *</label>
            <input value={form.goalWeight} onChange={set("goalWeight")} placeholder="e.g. 120 lbs, curvy / slim / athletic…" style={inp}/>
          </div>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Specific health goals *</label>
            <textarea value={form.healthGoals} onChange={set("healthGoals")} placeholder="e.g. lose 20 lbs, build muscle, more energy…" style={{...inp,minHeight:68,resize:"vertical"}}/>
          </div>

          <hr style={{border:"none",borderTop:"1px solid #eee",margin:"18px 0"}}/>
          <p style={secLabel}>Health Background</p>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Medical history / allergies</label>
            <textarea value={form.medicalHistory} onChange={set("medicalHistory")} placeholder="e.g. allergic to honey, nut allergy, diabetes…" style={{...inp,minHeight:60,resize:"vertical"}}/>
          </div>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Digestive issues</label>
            <textarea value={form.digestiveIssues} onChange={set("digestiveIssues")} placeholder="e.g. bloating, IBS, acid reflux…" style={{...inp,minHeight:60,resize:"vertical"}}/>
          </div>

          <hr style={{border:"none",borderTop:"1px solid #eee",margin:"18px 0"}}/>
          <p style={secLabel}>Lifestyle</p>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Daily schedule</label>
            <textarea value={form.dailySchedule} onChange={set("dailySchedule")} placeholder="e.g. 9–5 desk job, stay-at-home parent…" style={{...inp,minHeight:60,resize:"vertical"}}/>
          </div>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Meal prep routine</label>
            <textarea value={form.mealPrep} onChange={set("mealPrep")} placeholder="e.g. cook on Sundays, no time to cook…" style={{...inp,minHeight:60,resize:"vertical"}}/>
          </div>

          <hr style={{border:"none",borderTop:"1px solid #eee",margin:"18px 0"}}/>
          <p style={secLabel}>Diet & Budget</p>
          <div style={{marginBottom:16}}>
            <label style={lbl}>Dietary pattern</label>
            <div style={{display:"flex",flexWrap:"wrap",gap:8}}>
              {DIETS.map(d=>(
                <button key={d} onClick={()=>toggleDiet(d)} style={{
                  padding:"6px 14px", borderRadius:100, border:"1.5px solid",
                  cursor:"pointer", fontFamily:"inherit", fontSize:"0.78rem",
                  borderColor: diet.includes(d)?"#7a9e7e":"#ddd",
                  background: diet.includes(d)?"#7a9e7e":"#f8f7f4",
                  color: diet.includes(d)?"white":"#2a2a2a"
                }}>{d}</button>
              ))}
            </div>
          </div>
          <div style={{marginBottom:22}}>
            <label style={lbl}>Weekly grocery budget</label>
            <input value={form.groceryBudget} onChange={set("groceryBudget")} placeholder="e.g. $75/week, $150/week…" style={inp}/>
          </div>

          {error && (
            <div style={{background:"#fff0ec",border:"1px solid #f4c3b3",color:"#8b3a1f",
              borderRadius:8,padding:"12px 16px",fontSize:"0.825rem",marginBottom:16}}>
              {error}
            </div>
          )}

          <button onClick={generate} style={{
            width:"100%", padding:15, background:"#2a2a2a", color:"white",
            border:"none", borderRadius:10, fontFamily:"inherit",
            fontSize:"0.95rem", fontWeight:500, cursor:"pointer"
          }}>
            Generate My Plan →
          </button>
        </div>
      </div>
    </div>
  );
}
